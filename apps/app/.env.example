# Local values come from `pnpm exec supabase status -o env` (API_URL and PUBLISHABLE_KEY).
# Copy this file to .env.local and fill it in; .env.local is never committed.
EXPO_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_...), never the legacy anon key or a secret key.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 1 at export adds the large performance sample (?sample=mark-size). Export with --clear after changing it: the bundler cache keeps the old value.
EXPO_PUBLIC_PERF_SAMPLES=
# The web app's address (https://…, no trailing slash), so Compare's Copy link on a phone gives a link any browser opens. Without it a phone copies the app's own waypoint:// link.
EXPO_PUBLIC_WEB_URL=
# Server only, for the /api functions on Vercel (never EXPO_PUBLIC_, so they stay out of the app's bundle).
# /api/mercadona, Add an item's product search: the Algolia application id and the public search-only key that Mercadona's own web shop
# (tienda.mercadona.es) sends to its search; read them from the shop page's search requests. With either unset the search answers 503 mercadona_not_configured.
MERCADONA_ALGOLIA_APP_ID=
MERCADONA_ALGOLIA_KEY=
