# Copy to .env.local (never committed) for the variables the process does not set; see README.md.
# Local values come from `pnpm exec supabase status -o env` (API_URL and PUBLISHABLE_KEY).
SUPABASE_URL=
# The publishable key (sb_publishable_...), never a secret key.
SUPABASE_PUBLISHABLE_KEY=
# Optional: the web app's address, so answers link to the matching screen.
WAYPOINT_WEB_URL=
