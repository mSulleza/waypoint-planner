{
  "name": "waypoint",
  "private": true,
  "packageManager": "pnpm@9.11.0",
  "engines": { "node": ">=26" },
  "scripts": {
    "typecheck": "pnpm -r --parallel typecheck && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "pnpm --filter @waypoint/core --filter app --filter @waypoint/mcp test",
    "test:db": "pnpm --filter @waypoint/db-tests test",
    "import:cloud": "tsx scripts/import-to-cloud.ts",
    "web": "pnpm --filter app web"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@supabase/supabase-js": "2.117.3",
    "@types/node": "26.6.4",
    "eas-cli": "24.12.0",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "playwright-core": "1.64.0",
    "supabase": "2.120.0",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.1"
  }
}
